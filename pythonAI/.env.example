# Database
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_URL=jdbc:mysql://localhost:3306/system2?useUnicode=true&characterEncoding=utf-8&allowMultiQueries=true&useSSL=false&serverTimezone=GMT%2b8&allowPublicKeyRetrieval=true

# JWT
JWT_SECRET=your_jwt_secret_here_at_least_64_chars

# AI Callback Secret (must match between Spring Boot and Python AI)
AI_CALLBACK_SECRET=your_ai_callback_secret_here

# Ollama
OLLAMA_MODEL=gemma4:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Python AI Service
JAVA_SERVICE_BASE_URL=http://127.0.0.1:9096
