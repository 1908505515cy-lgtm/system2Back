# === 必需配置（不设置则服务无法启动）===

# Database
DB_USERNAME=root
DB_PASSWORD=your_password_here

# JWT Secret (min 64 chars)
JWT_SECRET=your_jwt_secret_here_at_least_64_chars

# AI Callback Secret (must match between Spring Boot and Python AI)
AI_CALLBACK_SECRET=your_ai_callback_secret_here

# === 可选配置 ===

# Spring Profile (dev/prod)
SPRING_PROFILES_ACTIVE=dev

# Ollama
OLLAMA_MODEL=gemma4:latest

# CORS (production: set to your frontend domain, e.g. https://yourdomain.com)
CORS_ALLOWED_ORIGINS=http://localhost:5174

# Logging
LOG_LEVEL=INFO
